// Application icon. ID 1 (lowest) is what Explorer shows for the EXE.
1 ICON "PDFtoPrinter.ico"

// Application manifest (type 24 = RT_MANIFEST, id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID).
// asInvoker + supportedOS list suppresses the PCA "did this program run correctly?" dialog.
1 24 "PDFtoPrinter.manifest"

// Version info (Properties > Details). version.h is generated by build.bat
// from VER_MAJOR/VER_MINOR/VER_PATCH/VER_STRING, defaulting to 0.0.0-dev.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION  VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  "PDFtoPrinter - print PDF files from the command line"
      VALUE "FileVersion",      VER_STRING
      VALUE "ProductName",      "PDFtoPrinter (C)"
      VALUE "ProductVersion",   VER_STRING
      VALUE "OriginalFilename", "PDFtoPrinterNative.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
